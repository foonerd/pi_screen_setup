    "_comment_hdmi": "=== HDMI DISPLAYS ===",

    "waveshare-11.9-hdmi": {
      "name": "Waveshare 11.9\" HDMI LCD (320x1480)",
      "type": "hdmi",
      "description": "Portrait native, requires rotation for landscape use",
      "native_resolution": "320x1480",
      "rotated_resolution": "1480x320",
      "config": {
        "hdmi_group": 2,
        "hdmi_mode": 87,
        "hdmi_timings": "320 0 80 16 32 1480 0 16 4 12 0 0 0 60 0 42000000 3",
        "max_framebuffer_height": 1480
      },
      "video_mode": "320x1480M@60",
      "recommended_rotation": 90,
      "notes": "Requires volumio-adaptive plymouth theme for proper boot splash"
    },
    "waveshare-7.9-hdmi": {
      "name": "Waveshare 7.9\" HDMI LCD (400x1280)",
      "type": "hdmi",
      "description": "Portrait native, requires rotation for landscape use",
      "native_resolution": "400x1280",
      "rotated_resolution": "1280x400",
      "config": {
        "hdmi_group": 2,
        "hdmi_mode": 87,
        "hdmi_timings": "400 0 220 32 110 1280 0 10 10 10 0 0 0 60 0 59400000 3"
      },
      "video_mode": "400x1280M@60",
      "recommended_rotation": 90,
      "notes": "Requires volumio-adaptive plymouth theme for proper boot splash"
    },
